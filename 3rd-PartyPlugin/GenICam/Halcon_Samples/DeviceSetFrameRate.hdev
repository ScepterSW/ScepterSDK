<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="20.11.1.0">
<procedure name="main">
<interface/>
<body>
<c>* </c>
<c>* Example for the usage of a Vzense 3D camera in HALCON.</c>
<c>* </c>
<c>* This sample shows how to set framerate and acquire images and data from the camera.</c>
<c></c>
<c>* Please note that you first need to install the matching Vzense</c>
<c>* GenTL Producer. After this, you can access the camera with the</c>
<c>* HALCON GenICamTL interface.</c>
<c>*</c>
<l>dev_close_window()</l>
<l>dev_update_off()</l>
<c>*</c>
<l>info_framegrabber ('GenICamTL', 'info_boards', Information, DeviceList)</l>
<l>tuple_regexp_select (DeviceList, 'sceptergentl.cti', Device)</l>
<l>if (Device == [])</l>
<c>     * No Vzense camera found</c>
<l>    stop ()</l>
<l>endif</l>
<l>try</l>
<l>    open_file('DeviceSetFrameRate.txt', 'output', FileHandle)</l>
<l>    fwrite_string(FileHandle, '---DeviceSetFrameRate---\n')</l>
<l>    tuple_regexp_match(Device[0], 'user_name:([^|]+)', user_name)</l>
<l>    fwrite_string(FileHandle, 'The first deviceInfo, &lt;serialNumber&gt;: '+ user_name +'\n')</l>
<l>    open_framegrabber ('GenICamTL', 1, 1, 0, 0, 0, 0, 'default', -1, 'default', -1, 'false', 'default', Device[0], -1, -1, AcqHandle)</l>
<l>    fwrite_string(FileHandle, 'Open framegrabber success.\n')</l>
<c>    * set work mode to active</c>
<l>    set_framegrabber_param(AcqHandle,'TriggerSelector', 'AcquisitionStart')</l>
<l>    get_framegrabber_param(AcqHandle,'TriggerMode', TriggerMode)</l>
<l>    if(TriggerMode != 'Off')</l>
<l>        set_framegrabber_param(AcqHandle,'TriggerMode', 'Off')</l>
<l>    endif</l>
<l>    fwrite_string(FileHandle, 'Set SC_ACTIVE_MODE.\n')</l>
<c>    * Set framerate to 5</c>
<l>    frameRate:=5</l>
<l>    set_framegrabber_param(AcqHandle, 'AcquisitionFrameRateEnable', true)</l>
<l>    set_framegrabber_param(AcqHandle, 'AcquisitionFrameRate', frameRate)</l>
<l>    fwrite_string(FileHandle, 'Set the device frame rate to ' + frameRate + '\n')</l>
<c>    * choose source selector</c>
<l>    set_framegrabber_param(AcqHandle, 'SourceSelector', 'Source0')</l>
<c>    * get ir/depth resolution</c>
<l>    get_framegrabber_param(AcqHandle, 'Width', Width)</l>
<l>    get_framegrabber_param(AcqHandle, 'Height', Height)</l>
<c></c>
<l>    get_framegrabber_param(AcqHandle,'ComponentSelector_values', ComponentSelectorValues)</l>
<c>    * Disable all components</c>
<l>    for Ind := 0 to |ComponentSelectorValues| - 1 by 1</l>
<l>        comp:=ComponentSelectorValues[Ind]</l>
<l>        set_framegrabber_param(AcqHandle, 'ComponentSelector', comp)</l>
<l>        set_framegrabber_param(AcqHandle, 'ComponentEnable', false)</l>
<l>    endfor</l>
<c>    * Enable Depth compoment</c>
<l>    set_framegrabber_param(AcqHandle, 'ComponentSelector', 'SC_DEPTH')</l>
<l>    set_framegrabber_param(AcqHandle, 'ComponentEnable', true)</l>
<c>    * Start acquisition</c>
<l>    *grab_image_start(AcqHandle, -1) // Only used in the async work mode</l>
<l>    fwrite_string(FileHandle, 'StartStream success.\n')</l>
<c>    * Open Window for dispaly</c>
<l>    dev_open_window (140, 140, Width, Height, 'black', WindowHandle_Depth)</l>
<l>    Frames := 0</l>
<l>    fwrite_string(FileHandle, 'Start testing the average frame rate for 30 seconds, please wait patiently.\n')</l>
<l>    count_seconds(StartTime)</l>
<l>    while(1)</l>
<l>        grab_data_async (Images, Region, XLD, AcqHandle, -1, null) // async work mode</l>
<l>        Frames := Frames + 1</l>
<l>        count_seconds(CurrentTime)</l>
<l>        ElapsedTime := CurrentTime - StartTime</l>
<c>        </c>
<l>        *FPS := Frames / ElapsedTime</l>
<l>        if(ElapsedTime &gt; 30)</l>
<l>            FPS := Frames / ElapsedTime</l>
<l>            fwrite_string(FileHandle, 'Average frame rate: ' + FPS + '\n')</l>
<l>            break    </l>
<l>        endif</l>
<l>        get_framegrabber_param(AcqHandle, 'image_source_id', image_source_id)</l>
<c>        * Display images</c>
<l>        count_obj(Images, NumImages)</l>
<l>        for Index := 1 to NumImages by 1</l>
<l>            if (image_source_id[Index-1] == 0x20250002)</l>
<l>                fwrite_string(FileHandle, 'GetFrame success. SC_DEPTH_FRAME &lt;frameIndex&gt; ' + Frames + '\n')</l>
<l>                disp_current_image (Images, Index, WindowHandle_Depth, 'Depth')</l>
<l>            endif</l>
<l>        endfor    </l>
<l>    endwhile</l>
<l>    close_framegrabber(AcqHandle)</l>
<l>    fwrite_string(FileHandle, 'Close framegrabber success.\n')</l>
<l>    fwrite_string(FileHandle, '---End---\n')</l>
<l>    close_file(FileHandle)</l>
<l>    dev_close_window()</l>
<l>catch(Exception)</l>
<l>     dev_get_exception_data (Exception, 'error_code', error_code)</l>
<l>     dev_get_exception_data (Exception, 'error_msg', errorMsg)</l>
<l>     dev_get_exception_data (Exception, 'add_error_message', add_error_message)</l>
<l>     dev_get_exception_data (Exception, 'program_line', program_line)</l>
<l>     dev_get_exception_data (Exception, 'operator', operator)</l>
<l>     outPutMsg:= add_error_message + ' Operator: ' + operator + ' ErrorMsg: ' + errorMsg + ' ErrorCode: ' + error_code + ' Line: ' + program_line</l>
<l>     fwrite_string(FileHandle, outPutMsg + '\n')</l>
<l>     close_framegrabber (AcqHandle)</l>
<l>     close_file(FileHandle)</l>
<l>     stop()</l>
<l>endtry</l>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
<procedure name="disp_current_image">
<interface>
<io>
<par name="Images" base_type="iconic" dimension="0"/>
</io>
<ic>
<par name="Index" base_type="ctrl" dimension="0"/>
<par name="WindowHandle" base_type="ctrl" dimension="0"/>
<par name="Title" base_type="ctrl" dimension="0"/>
</ic>
</interface>
<body>
<l>select_obj (Images, Image, Index)</l>
<l>dev_set_window (WindowHandle)</l>
<l>if (strstr(Title, 'IR') == 0)</l>
<l>   dev_set_lut('inv_sqrt')</l>
<l>endif</l>
<l>dev_display (Image)</l>
<l>dev_disp_text (Title, 'window', 12, 12, 'black', [], [])</l>
<l>return ()</l>
</body>
<docu id="disp_current_image">
<parameters>
<parameter id="Images"/>
<parameter id="Index"/>
<parameter id="Title"/>
<parameter id="WindowHandle"/>
</parameters>
</docu>
</procedure>
<procedure name="create_3d_window">
<interface>
<ic>
<par name="Width" base_type="ctrl" dimension="0"/>
<par name="Height" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="Window3DHande" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>            dev_open_window (0, 2*Width, Width, Height, 'black', Window3DHande)</l>
<l>            dev_set_window (Window3DHande)</l>
<l>            dev_set_lut('default')</l>
<l>return ()</l>
</body>
<docu id="create_3d_window">
<parameters>
<parameter id="Height"/>
<parameter id="Width"/>
<parameter id="Window3DHande"/>
</parameters>
</docu>
</procedure>
</hdevelop>
